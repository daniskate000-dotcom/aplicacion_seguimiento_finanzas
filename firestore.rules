rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'monthlyBudget',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'displayName',
          'monthlyBudget',
          'onboardingCompleted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 60 &&
        data.monthlyBudget is number &&
        data.monthlyBudget > 0 &&
        data.monthlyBudget <= 1000000000 &&
        data.onboardingCompleted is bool &&
        data.onboardingCompleted == true &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExpenseDetails(data) {
      return data.category in [
          'alimentacion',
          'transporte',
          'servicios',
          'ropa',
          'entretenimiento'
        ] &&
        !('incomeCategory' in data) &&
        !('paymentMethod' in data) &&
        !('fullDateText' in data);
    }

    function isValidIncomeDetails(data) {
      return data.incomeCategory in [
          'Salario',
          'Trabajo independiente',
          'Negocio',
          'Inversiones',
          'Regalo',
          'Bonificación',
          'Reembolso',
          'Otro'
        ] &&
        data.paymentMethod in [
          'Efectivo',
          'Cuenta bancaria',
          'Nequi',
          'Daviplata',
          'Tarjeta',
          'Otro'
        ] &&
        data.fullDateText is string &&
        data.fullDateText.size() >= 1 &&
        data.fullDateText.size() <= 60 &&
        !('category' in data);
    }

    function isValidMovement(data) {
      return data.keys().hasAll([
          'ownerId',
          'type',
          'day',
          'dateLabel',
          'timeLabel',
          'concept',
          'amount',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId',
          'type',
          'day',
          'dateLabel',
          'timeLabel',
          'concept',
          'amount',
          'category',
          'incomeCategory',
          'paymentMethod',
          'fullDateText',
          'note',
          'createdAt'
        ]) &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.type in ['expense', 'income'] &&
        data.day is number &&
        data.day >= 1 &&
        data.day <= 31 &&
        data.dateLabel is string &&
        data.dateLabel.size() >= 1 &&
        data.dateLabel.size() <= 40 &&
        data.timeLabel is string &&
        data.timeLabel.size() >= 1 &&
        data.timeLabel.size() <= 30 &&
        data.concept is string &&
        data.concept.size() >= 1 &&
        data.concept.size() <= 160 &&
        data.amount is number &&
        data.amount > 0 &&
        data.amount <= 1000000000 &&
        data.createdAt is timestamp &&
        (!('note' in data) || (data.note is string && data.note.size() <= 500)) &&
        (
          (data.type == 'expense' && isValidExpenseDetails(data)) ||
          (data.type == 'income' && isValidIncomeDetails(data))
        );
    }

    // Master Gate relational verification against parent profile
    function ownsUserProfile(userId) {
      return isOwner(userId) &&
        exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // 4. User Profile Collection (strictly owner-isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['monthlyBudget', 'displayName', 'updatedAt'])
        );

      allow delete: if false;

      // 5. Private Movements Subcollection (strictly owner-isolated)
      match /movements/{movementId} {
        allow get: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid;

        allow list: if isValidId(userId) &&
          isOwner(userId) &&
          resource.data.ownerId == request.auth.uid;

        allow create: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          isValidMovement(incoming()) &&
          incoming().createdAt == request.time &&
          ownsUserProfile(userId);

        allow update: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          isValidMovement(incoming()) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().type == existing().type &&
          ownsUserProfile(userId) &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['concept', 'amount', 'note']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['concept', 'amount', 'category', 'note'])
          );

        allow delete: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          existing().ownerId == request.auth.uid &&
          ownsUserProfile(userId);
      }
    }
  }
}
